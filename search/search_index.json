0432 \u0433.\u041e\u0431\u043d\u0438\u043d\u0441\u043a. \u0421 \u0441\u0430\u043c\u043e\u0433\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043b\u0441\u044f backend-\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043c\u043d\u0435 \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043b\u043e\u0433\u0438\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \"\u043f\u043e\u0434 \u043a\u0430\u043f\u043e\u0442\u043e\u043c\" \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439.</p>"},{"location":"about/#_3","title":"\u0427\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u0437\u0443\u0447\u0430\u044e","text":"<ol> <li>FastAPI \u2014 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0431\u044b\u0441\u0442\u0440\u044b\u0445 \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 API</li> <li>Docker \u2014 \u0447\u0442\u043e\u0431\u044b \u0443\u043f\u0430\u043a\u043e\u0432\u044b\u0432\u0430\u0442\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0432 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u044b</li> <li>\u0411\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u2014 PostgreSQL \u0434\u043b\u044f \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 Redis \u0434\u043b\u044f \u043a\u044d\u0448\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f</li> <li>\u0410\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u043e\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u2014 \u0434\u043b\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0441 I/O</li> </ol>"},{"location":"about/#2026","title":"\u0426\u0435\u043b\u0438 \u043d\u0430 2026 \u0433\u043e\u0434","text":"<ul> <li>\u0423\u0441\u043f\u0435\u0448\u043d\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c 2 \u043a\u0443\u0440\u0441 </li> <li>\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u044b\u0439 backend-\u043f\u0440\u043e\u0435\u043a\u0442</li> <li>\u0420\u0430\u0437\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0441 \u043c\u0438\u043a\u0440\u043e\u0441\u0435\u0440\u0432\u0438\u0441\u043d\u043e\u0439 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u043e\u0439</li> <li>\u041d\u0430\u0443\u0447\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c CI/CD \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432</li> </ul>"},{"location":"about/#_4","title":"\u041f\u043e\u0447\u0435\u043c\u0443 \u044d\u0442\u043e\u0442 \u0431\u043b\u043e\u0433?","text":"<p>\u0417\u0434\u0435\u0441\u044c \u044f \u0431\u0443\u0434\u0443 \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0441\u0432\u043e\u0438\u043c\u0438 \u043c\u044b\u0441\u043b\u044f\u043c\u0438, \u043f\u0438\u0441\u0430\u0442\u044c DOCS \u0434\u043b\u044f \u043c\u043e\u0438\u0445 \u043f\u0435\u0442-\u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432.</p>"},{"location":"about/#_5","title":"\u0425\u043e\u0431\u0431\u0438 \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b","text":"<p>\u041f\u043e\u043c\u0438\u043c\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f:</p> \ud83c\udfac \u041a\u0438\u043d\u043e \u0438 \u0441\u0435\u0440\u0438\u0430\u043b\u044b \u041b\u044e\u0431\u043b\u044e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0435 \u0441\u044e\u0436\u0435\u0442\u044b \ud83c\udfae \u0418\u0433\u0440\u044b \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0438 RPG \ud83c\udfcb\ufe0f \u0421\u043f\u043e\u0440\u0442\u0437\u0430\u043b 3 \u0440\u0430\u0437\u0430 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u2615 \u041a\u043e\u0444\u0435 \u041b\u044e\u0431\u043b\u044e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u0444\u0435"},{"location":"about/#_6","title":"\ud83d\udee0 \u042d\u0442\u043e\u0442 \u0441\u0430\u0439\u0442","text":"<p>\u0421\u0434\u0435\u043b\u0430\u043d \u043d\u0430 MkDocs \u0441 \u0442\u0435\u043c\u043e\u0439 Material. \u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u043a\u043e\u0434 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0432 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0438.</p> <p>\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e: \u0424\u0435\u0432\u0440\u0430\u043b\u044c 2026</p>"}]}